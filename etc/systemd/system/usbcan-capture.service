[Unit]
Description=RoboPi seven-dimensional communication recorder
Documentation=file:/usr/share/doc/robopi-analyze/README.md
After=local-fs.target systemd-modules-load.service hpm-log-capture.service
Wants=hpm-log-capture.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/default/usbcan-capture
RuntimeDirectory=usbcan
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/opt/roboparty/bin/robopi-seven-capture
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
# Teardown runs a full log2asc conversion over the whole can.log; on a long
# high-traffic session that alone can exceed 30s, and being killed mid-way
# leaves manifest.json without ended_at_unix.
TimeoutStopSec=300
Nice=15
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
CPUAffinity=0 1
UMask=0027

[Install]
WantedBy=multi-user.target
