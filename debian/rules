%:
	dh $@

override_dh_auto_install:
	install -d $(CURDIR)/debian/robopi-analyze/opt/roboparty/bin \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/lib/robopi-analyze/dimensions \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/lib/robopi-analyze/analysis \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/lib/firmware \
		$(CURDIR)/debian/robopi-analyze/etc/default \
		$(CURDIR)/debian/robopi-analyze/lib/systemd/system
	install -D -m 0755 capture/capture_seven_dimensions.sh \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/robopi-seven-capture
	install -D -m 0755 capture/capture_usbcan_ring.sh \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/usbcan-capture
	install -D -m 0755 capture/capture_hpm_uart.sh \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/hpm-log-capture
	install -m 0755 dimensions/* \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/lib/robopi-analyze/dimensions/
	install -m 0755 analysis/*.py \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/lib/robopi-analyze/analysis/
	install -D -m 0755 analysis/analyze_seven_dimensions.py \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/robopi-seven-analyze
	install -D -m 0755 analysis/analyze_can_asc.py \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/analyze-can-asc
	install -D -m 0755 dimensions/06_can_asc.sh \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/robopi-can-capture
	install -D -m 0755 bin/export_seven_dimensions.sh \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/robopi-seven-export
	install -D -m 0755 bin/save_usbcan_snapshot.sh \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/usbcan-debug-snapshot
	install -D -m 0755 bin/restart_can_interfaces.sh \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/robopi-can-restart
	install -D -m 0755 bin/show_communication_dashboard.py \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/robopi-comm-status
	install -D -m 0755 bin/analyze_ethercan_pcap.py \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/analyze-ethercan-pcap
	install -D -m 0755 bin/flash_hpm.sh \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/flash_hpm.sh
	install -D -m 0755 bin/hpmtool.py \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/hpmtool
	install -D -m 0755 bin/hpm_sreset.sh \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/hpm_sreset
	install -D -m 0755 bin/cleanup_sessions.sh \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/robopi-session-cleanup
	install -D -m 0755 capture/flush_session.sh \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/bin/robopi-session-flush
	install -m 0644 etc/firmware/* \
		$(CURDIR)/debian/robopi-analyze/opt/roboparty/lib/firmware/
	install -m 0644 etc/default/* \
		$(CURDIR)/debian/robopi-analyze/etc/default/
	install -m 0644 etc/systemd/system/* \
		$(CURDIR)/debian/robopi-analyze/lib/systemd/system/
	install -d $(CURDIR)/debian/robopi-analyze/usr/bin
	ln -sf /opt/roboparty/bin/robopi-seven-capture $(CURDIR)/debian/robopi-analyze/usr/bin/robopi-seven-capture
	ln -sf /opt/roboparty/bin/robopi-seven-analyze $(CURDIR)/debian/robopi-analyze/usr/bin/robopi-seven-analyze
	ln -sf /opt/roboparty/bin/analyze-can-asc $(CURDIR)/debian/robopi-analyze/usr/bin/analyze-can-asc
	ln -sf /opt/roboparty/bin/robopi-seven-export $(CURDIR)/debian/robopi-analyze/usr/bin/robopi-seven-export
	ln -sf /opt/roboparty/bin/robopi-session-cleanup $(CURDIR)/debian/robopi-analyze/usr/bin/robopi-session-cleanup
	ln -sf /opt/roboparty/bin/robopi-comm-status $(CURDIR)/debian/robopi-analyze/usr/bin/robopi-comm-status
	ln -sf /opt/roboparty/bin/usbcan-capture $(CURDIR)/debian/robopi-analyze/usr/bin/usbcan-capture
	ln -sf /opt/roboparty/bin/usbcan-debug-snapshot $(CURDIR)/debian/robopi-analyze/usr/bin/usbcan-debug-snapshot
	ln -sf /opt/roboparty/bin/hpm-log-capture $(CURDIR)/debian/robopi-analyze/usr/bin/hpm-log-capture
	ln -sf /opt/roboparty/bin/robopi-can-capture $(CURDIR)/debian/robopi-analyze/usr/bin/robopi-can-capture
	ln -sf /opt/roboparty/bin/robopi-can-restart $(CURDIR)/debian/robopi-analyze/usr/bin/robopi-can-restart

override_dh_installsystemd:
	dh_installsystemd hpm-log-capture.service
	dh_installsystemd hpm-sreset.service
	dh_installsystemd --no-start usbcan-capture.service
